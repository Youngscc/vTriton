    {
      "name": "sync_overhead_global",
      "description": "Global SyncOverhead wins when sync/barrier cycles exceed C++ thresholds.",
      "operations": [
        {
          "id": 0,
          "name": "vadd",
          "pipe": "Vector",
          "duration": 70,
          "start_cycle": 0,
          "end_cycle": 70,
          "depends_on": [],
          "is_sync": false,
          "is_barrier": false,
          "bytes": 0,
          "elements": 1024,
          "flops": 1024,
          "loop_multiplier": 1,
          "src_space": "ub",
          "dst_space": "ub",
          "elem_type": "fp16",
          "repeat": 1,
          "mask": 128,
          "line": 10,
          "core_type": "AIV",
          "event_id": 0
        },
        {
          "id": 1,
          "name": "pipe_barrier",
          "pipe": "All",
          "duration": 30,
          "start_cycle": 70,
          "end_cycle": 100,
          "depends_on": [0],
          "is_sync": true,
          "is_barrier": true,
          "bytes": 0,
          "elements": 0,
          "flops": 0,
          "loop_multiplier": 1,
          "src_space": "",
          "dst_space": "",
          "elem_type": "fp16",
          "repeat": 1,
          "mask": 0,
          "line": 11,
          "core_type": "AIV",
          "event_id": 1
        }
      ],
      "expected": {
        "global_root_cause": "SyncOverhead",
        "pipeline_root_cause": "ComputeBound",
        "pipeline_bottleneck": "Vector",
        "sync_overhead_ratio": 30.0,
        "barrier_overhead_ratio": 30.0,
        "op_root_causes": {
          "0": "ComputeBound",
          "1": "SyncOverhead"
        }
      }
    },
